<!-- Custom Rules for NCS Project: Suricata DPI & Kubernetes Audit -->
<group name="local,syslog,sshd,">

  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<!-- 1. SURICATA DPI ENHANCED DETECTION                          -->
<group name="ids,suricata,">

  <!-- Nâng mức cảnh báo cho Suricata Severity 1 (Exploits, RCE, High Threats) -->
  <rule id="100100" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.severity">^1$</field>
    <description>Suricata: High Severity Threat - $(alert.signature) [$(src_ip) -> $(dest_ip)]</description>
    <group>ids,suricata,attack,</group>
  </rule>

  <!-- Phát hiện các cuộc tấn công Web đặc thù (SQLi, XSS, Path Traversal, Web Shells) -->
  <rule id="100101" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.category" type="pcre2">Web Application Attack|Attempted Administrator Privilege Gain|Attempted User Privilege Gain|Exploit|Command and Control</field>
    <description>Suricata: Web Application Attack - $(alert.signature) [$(src_ip) -> $(dest_ip):$(dest_port)]</description>
    <group>ids,suricata,web_attack,</group>
  </rule>

  <!-- Suricata IPS đã chủ động chặn (Blocked/Dropped) gói tin độc hại -->
  <rule id="100102" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.action" type="pcre2">blocked|dropped</field>
    <description>Suricata IPS: Blocked Malicious Traffic - $(alert.signature) from $(src_ip)</description>
    <group>ids,suricata,ips_blocked,</group>
  </rule>

  <!-- Phát hiện quét cổng và thăm dò hệ thống (Reconnaissance) -->
  <rule id="100103" level="6">
    <if_sid>86601</if_sid>
    <field name="alert.category" type="pcre2">Potentially Bad Traffic|Detection of a Network Scan</field>
    <description>Suricata: Network Scan / Reconnaissance - $(alert.signature) from $(src_ip)</description>
    <group>ids,suricata,reconnaissance,</group>
  </rule>

  <!-- Phát hiện mã độc, botnet, trojan trong luồng mạng -->
  <rule id="100104" level="11">
    <if_sid>86601</if_sid>
    <field name="alert.category" type="pcre2">A Network Trojan was detected|Trojan-Activity</field>
    <description>Suricata: Malware/Trojan Activity Detected - $(alert.signature) [$(src_ip) -> $(dest_ip)]</description>
    <group>ids,suricata,trojan,</group>
  </rule>

</group>

<!-- 2. KUBERNETES AUDIT LOG RULES                                -->
<group name="k8s,k8s_audit,">

  <!-- Base rule nhận diện sự kiện Kubernetes Audit -->
  <rule id="110000" level="0">
    <decoded_as>json</decoded_as>
    <field name="apiVersion" type="pcre2">^audit\.k8s\.io/</field>
    <description>Kubernetes audit event grouping.</description>
    <group>k8s,k8s_audit,</group>
  </rule>

  <!-- Bỏ qua các probe health check định kỳ (liveness, readiness) để tránh nhiễu SIEM -->
  <rule id="110001" level="0">
    <if_sid>110000</if_sid>
    <field name="requestURI" type="pcre2">^/(livez|readyz|healthz|version|openapi)</field>
    <description>Kubernetes: Health check probe (silenced).</description>
    <group>k8s,k8s_audit,</group>
  </rule>

  <!-- Phát hiện yêu cầu API bị Từ chối hoặc Không có quyền (401/403) -->
  <rule id="110002" level="7">
    <if_sid>110000</if_sid>
    <field name="requestURI" negate="yes" type="pcre2">^/(livez|readyz|healthz|version|openapi)</field>
    <field name="responseStatus.code" type="pcre2">^(401|403)$</field>
    <description>Kubernetes: Unauthorized/Forbidden API request (HTTP $(responseStatus.code)) by $(user.username) [URI: $(requestURI)]</description>
    <group>k8s,k8s_audit,access_denied,</group>
  </rule>

  <!-- Phát hiện truy cập Secrets bất thường bởi user hoặc tài khoản ngoài Core System / Operator -->
  <rule id="110003" level="8">
    <if_sid>110000</if_sid>
    <field name="requestURI">secrets</field>
    <field name="verb" type="pcre2">^(get|list|watch)$</field>
    <field name="user.username" negate="yes" type="pcre2">^system:(apiserver|kube-|serviceaccount:(cattle|cert-manager|kube-system))</field>
    <description>Kubernetes: Sensitive Secret resource accessed by $(user.username) [URI: $(requestURI)]</description>
    <group>k8s,k8s_audit,credential_access,</group>
  </rule>

  <!-- Whitelist 1: Kubelet daemon node truy cap hop le de mount Secret vao Pod -->
  <rule id="110010" level="0">
    <if_sid>110003</if_sid>
    <field name="user.username" type="pcre2">^system:node:</field>
    <description>Kubernetes: Authorized Kubelet node secret access (silenced).</description>
    <group>k8s,k8s_audit,</group>
  </rule>

  <!-- Whitelist 2: Platform Ingress-NGINX, Cilium va Rancher Operator service accounts -->
  <rule id="110011" level="0">
    <if_sid>110003</if_sid>
    <field name="user.username" type="pcre2">^system:serviceaccount:(ingress-nginx|cilium|cattle-[a-z0-9\-]+):</field>
    <description>Kubernetes: Platform service account (Ingress-NGINX / Cilium / Rancher) secret access (silenced).</description>
    <group>k8s,k8s_audit,</group>
  </rule>

  <!-- Whitelist 3: Helm Package Manager truy van metadata release state -->
  <rule id="110012" level="0">
    <if_sid>110003</if_sid>
    <field name="requestURI" type="pcre2">(owner(=|%3D)helm|helm\.sh)</field>
    <description>Kubernetes: Helm package manager release state check (silenced).</description>
    <group>k8s,k8s_audit,</group>
  </rule>

  <!-- Phát hiện chạy lệnh tương tác bên trong Pod (Exec / Attach into Pod) -->
  <rule id="110004" level="9">
    <if_sid>110000</if_sid>
    <field name="requestURI" type="pcre2">/exec|/attach</field>
    <description>Kubernetes: Interactive container execution (exec/attach) by $(user.username) [URI: $(requestURI)]</description>
    <group>k8s,k8s_audit,execution,</group>
  </rule>

  <!-- Phát hiện thay đổi quyền leo thang (RBAC: ClusterRole, RoleBinding) ngoài Core Operator -->
  <rule id="110005" level="10">
    <if_sid>110000</if_sid>
    <field name="requestURI" type="pcre2">clusterrolebindings|rolebindings|clusterroles|roles</field>
    <field name="verb" type="pcre2">^(create|update|patch|delete)$</field>
    <field name="user.username" negate="yes" type="pcre2">^system:(apiserver|kube-|serviceaccount:(cattle|cert-manager|kube-system))</field>
    <description>Kubernetes: RBAC privilege modification by $(user.username) [URI: $(requestURI)]</description>
    <group>k8s,k8s_audit,privilege_escalation,</group>
  </rule>

  <!-- Phát hiện xóa tài nguyên quan trọng trong cụm bởi user không phải Core System -->
  <rule id="110006" level="8">
    <if_sid>110000</if_sid>
    <field name="verb">^delete$</field>
    <field name="user.username" negate="yes" type="pcre2">^system:(kube-|serviceaccount:(cattle|cert-manager|kube-system))</field>
    <description>Kubernetes: Resource deletion request by $(user.username) [URI: $(requestURI)]</description>
    <group>k8s,k8s_audit,impact,</group>
  </rule>

  <!-- Phát hiện request từ người dùng ẩn danh (system:anonymous) vào Kubernetes API -->
  <rule id="110007" level="9">
    <if_sid>110000</if_sid>
    <field name="user.username">^system:anonymous$</field>
    <field name="requestURI" negate="yes" type="pcre2">^/(livez|readyz|healthz|version|openapi)</field>
    <description>Kubernetes: Unauthenticated API request from anonymous user [URI: $(requestURI)]</description>
    <group>k8s,k8s_audit,anonymous_access,</group>
  </rule>

</group>

<!-- 3. FALCO CONTAINER RUNTIME SECURITY DETECTION              -->
<group name="falco,container_runtime,">

  <!-- Base rule nhận diện sự kiện Falco Runtime Security (JSON) -->
  <rule id="120000" level="0">
    <decoded_as>json</decoded_as>
    <field name="rule" type="pcre2">.+</field>
    <field name="output" type="pcre2">.+</field>
    <description>Falco Container Runtime event grouping.</description>
    <group>falco,container_runtime,</group>
  </rule>

  <!-- Cảnh báo mức độ Thông báo / Cảnh báo (Notice, Warning) -->
  <rule id="120001" level="7">
    <if_sid>120000</if_sid>
    <field name="priority" type="pcre2">^(Warning|Notice)$</field>
    <description>Falco Alert: $(rule) - $(output)</description>
    <group>falco,runtime_warning,</group>
  </rule>

  <!-- Whitelist 4: Khoi tao container Redis-stack hop le trong Falco sidekick UI -->
  <rule id="120010" level="0">
    <if_sid>120001</if_sid>
    <field name="output" type="pcre2">container_name=redis.+command=sh /entrypoint\.sh</field>
    <description>Falco: Benign Redis Stack container startup entrypoint (silenced).</description>
    <group>falco,container_runtime,</group>
  </rule>

  <!-- Cảnh báo mức độ Nguy hiểm cao (Error, Critical, Alert, Emergency) -->
  <rule id="120002" level="10">
    <if_sid>120000</if_sid>
    <field name="priority" type="pcre2">^(Error|Critical|Alert|Emergency)$</field>
    <description>Falco High Severity Threat: $(rule) - $(output)</description>
    <group>falco,runtime_threat,</group>
  </rule>

</group>

