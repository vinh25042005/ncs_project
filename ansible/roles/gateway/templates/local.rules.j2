# NCS custom rules — chế độ: {{ 'IPS/drop' if gateway_suricata_ips | bool else 'IDS/alert' }}
{% set act = 'drop' if gateway_suricata_ips | bool else 'alert' %}
{{ act }} tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"NCS LOCAL Quet cong TCP SYN"; flags:S,12; flow:stateless; threshold:type both, track by_src, count 30, seconds 10; classtype:attempted-recon; sid:1000001; rev:2;)
{{ act }} http $EXTERNAL_NET any -> $HOME_NET any (msg:"NCS LOCAL Cong cu sqlmap"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:1000002; rev:2;)
{{ act }} http $EXTERNAL_NET any -> $HOME_NET any (msg:"NCS LOCAL Cong cu Nikto"; flow:established,to_server; http.user_agent; content:"Nikto"; nocase; classtype:web-application-attack; sid:1000003; rev:2;)
{{ act }} http $EXTERNAL_NET any -> $HOME_NET any (msg:"NCS LOCAL SQLi UNION SELECT"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:1000004; rev:2;)
{{ act }} http $EXTERNAL_NET any -> $HOME_NET any (msg:"NCS LOCAL Path Traversal etc-passwd"; flow:established,to_server; http.uri; content:"etc/passwd"; nocase; classtype:web-application-attack; sid:1000005; rev:2;)
{{ act }} http $EXTERNAL_NET any -> $HOME_NET any (msg:"NCS LOCAL XSS script tag"; flow:established,to_server; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:1000006; rev:2;)
{{ act }} http $EXTERNAL_NET any -> $HOME_NET any (msg:"NCS LOCAL Do file nhay cam"; flow:established,to_server; http.uri; pcre:"/\/\.(env|git\/config)/i"; classtype:attempted-recon; sid:1000007; rev:2;)
